{
  "name": "vex-client-launcher",
  "productName": "VEX CLIENT",
  "version": "2.6.2",
  "description": "VEX CLIENT — Minecraft launcher. Play different.",
  "author": "Albatron2580",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder --win --x64 --dir --publish never && node scripts/make-installer.cjs",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "net.vexclient.launcher",
    "productName": "VEX CLIENT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Albatron2580",
        "repo": "vex-client"
      }
    ],
    "afterPack": "scripts/afterPack.cjs",
    "extraResources": [
      {
        "from": "../server",
        "to": "online-server",
        "filter": [
          "package.json",
          "package-lock.json",
          "tsconfig.json",
          "wrangler.toml",
          "src/**",
          "migrations/**"
        ]
      }
    ]
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resedit": "^2.0.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "sql.js": "^1.15.1"
  }
}
