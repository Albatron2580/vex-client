{
  "schemaVersion": 1,
  "id": "vexclient",
  "version": "${version}",
  "name": "VEX CLIENT",
  "description": "VEX CLIENT in game: press Right Shift for the menu. HUD, zoom, sprint, combat HUD, themes and the grey V badge. Addons only, no hacks.",
  "authors": ["lyano"],
  "contact": { "homepage": "https://github.com/Albatron2580/vex-client" },
  "license": "All-Rights-Reserved",
  "icon": "assets/vexclient/icon.png",
  "environment": "client",
  "entrypoints": { "client": ["net.vexclient.mod.VexClientMod"] },
  "mixins": ["vexclient.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*",
    "java": ">=21"
  }
}
