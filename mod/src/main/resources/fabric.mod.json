{
  "schemaVersion": 1,
  "id": "vexclient",
  "version": "${version}",
  "name": "Vex Client",
  "description": "Vex Client in-game settings: HUD (FPS, coordinates, facing), zoom, always-sprint. Press Right Shift.",
  "authors": ["lyano"],
  "contact": { "homepage": "https://github.com/Albatron2580/vex-client" },
  "license": "All-Rights-Reserved",
  "icon": "assets/vexclient/icon.png",
  "environment": "client",
  "entrypoints": { "client": ["net.vexclient.mod.VexClientMod"] },
  "mixins": ["vexclient.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*",
    "java": ">=21"
  }
}
