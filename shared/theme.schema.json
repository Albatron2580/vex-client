{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vex-client/theme.schema.json",
  "title": "VEX CLIENT theme",
  "description": "Shared by the launcher and the in-game client. Colors are #rrggbb. A theme file exported from VEX CLIENT has { schemaVersion, theme }.",
  "type": "object",
  "required": ["id", "name", "accent", "accent2", "background", "panel", "border", "text", "opacity", "glow", "radius"],
  "properties": {
    "id":         { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
    "name":       { "type": "string", "minLength": 1, "maxLength": 40 },
    "accent":     { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "accent2":    { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Second gradient stop" },
    "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "panel":      { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "border":     { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "text":       { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "opacity":    { "type": "number", "minimum": 0.3, "maximum": 1, "description": "Panel opacity" },
    "glow":       { "type": "number", "minimum": 0, "maximum": 1, "description": "Glow intensity" },
    "radius":     { "type": "integer", "minimum": 0, "maximum": 28, "description": "Corner radius in px" }
  }
}
