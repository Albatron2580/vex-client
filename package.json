{
  "name": "vex-client",
  "version": "1.1.0",
  "description": "Vex Client - a Minecraft launcher with Modrinth mods, modpacks, resource packs, shaders and profiles",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "setup-updates": "node scripts/setup-updates.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.vex.client",
    "productName": "Vex Client",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "lib/**",
      "renderer/**"
    ],
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Albatron2580",
        "repo": "vex-client",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Vex-Client-Setup-${version}.${ext}",
      "differentialPackage": true
    }
  },
  "productName": "Vex Client",
  "vexUpdate": {
    "owner": "Albatron2580",
    "repo": "vex-client",
    "publicKey": "MCowBQYDK2VwAyEAveSz6Ni681sY5wa8uiAo1lQw20Qt8PgCUAex0UhQ/y4="
  },
  "vexAdmins": [
    "HAckerbest11",
    "RaxMc",
    "UNCdel"
  ],
  "vexServer": {
    "name": "VexVanilla",
    "host": "vexvanilla.net",
    "port": 25565,
    "region": "EU",
    "discord": "https://discord.gg/VexVanilla"
  }
}
